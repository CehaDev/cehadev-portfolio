# Konfigurasi OpenClaw Article Agent — salin ke project root sebagai .env.openclaw
#
#   cp docs/openclaw/.env.openclaw.example .env.openclaw
#   nano .env.openclaw      <- isi nilai di bawah
#   bash scripts/setup-openclaw.sh
#
# File .env.openclaw TIDAK dicommit ke git (lihat .gitignore).

# Token bot Telegram dari @BotFather (chat @BotFather -> /newbot)
TELEGRAM_BOT_TOKEN=

# Gemini API key dari https://aistudio.google.com/apikey (gratis)
GEMINI_API_KEY=

# Opsional — chat ID Telegram Anda. Untuk kontrol akses strict (allowlist).
# Cek setelah pairing: kirim /whoami ke bot, atau pakai @userinfobot.
TELEGRAM_ADMIN_CHAT_ID=

# Opsional — jam & menit bot otomatis harian membuat 1 draft (format: 0-23 / 0-59)
OPENCLAW_CRON_HOUR=8
OPENCLAW_CRON_MIN=0
